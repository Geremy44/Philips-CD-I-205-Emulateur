# =============================================================================
# .gitignore — Philips CD-i 205 Émulateur
# =============================================================================

# ⛔ ROMs & images CD-i — COPYRIGHT Philips — NE JAMAIS COMMITTER
# -----------------------------------------------------------------------------
# NB : git ne gère pas les commentaires en fin de ligne, chaque commentaire
# doit être sur sa propre ligne.
# dumps ROM / firmware / modules extraits (toutes casses)
*.[bB][iI][nN]
*.[rR][oO][mM]
*.[hH][eE][xX]
*.os9
# images CD-ROM / disque
*.[iI][sS][oO]
*.[iI][mM][gG]
# dossiers contenant des dumps
ROM/
ROMs/
ROMS/
roms/
Firmware/
firmware/
# modules OS-9 extraits de la ROM et projets de désassemblage (contiennent la ROM)
tools/modules/
tools/modules_fmv/
*.gpr
*.rep/
# copies de dossiers .git (contiennent tout l'historique, ROM comprises)
.git.backup/
*.bundle
# archives de sauvegarde du code (contiennent la ROM)
src/cdi_emu*.zip

# 🛠️ Build de l'émulateur
# -----------------------------------------------------------------------------
*.o
*.exe
src/cdi_emu/bin/
# NVRAM sauvegardée par l'émulateur (données utilisateur)
nvram.bin
nvram.rtc
# slots de sauvegarde (F5 / F9) et fichiers temporaires d'écriture
saves/
*.tmp

# ⛔ Fichiers temporaires système
# -----------------------------------------------------------------------------
# macOS
.DS_Store
# Windows
Thumbs.db
# backup Emacs/vim
*~
# vim swap
*.swp
# vim
*.swo
# backups
*.bak

# 🐍 Python
# -----------------------------------------------------------------------------
# cache bytecode
__pycache__/
# bytecode compilé
*.py[cod]
*.pyc
*.pyo
*.pyd
# environnement virtuel
.venv/
venv/
ENV/
env/
# setuptools
*.egg-info/
# build wheels
dist/
# build artifacts
build/
.pip-wheel-metadata

# 📦 Node (si applicable plus tard)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 🛠️ IDE
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace

# 📝 Logs & exports
# -----------------------------------------------------------------------------
*.log
*.trace
output/
dump/
